#!/bin/bash

set -euo pipefail

script=`basename $0`
script_dir=$(dirname $(realpath $0))
here_base_dir="$HOME/.here"

editor="${EDITOR:-code}"

here_serialize_pwd() {
  pwd | sed "s#$HOME#HOME#" | tr / '~'
}

here_target_dir() {
  echo "$here_base_dir/$(here_serialize_pwd)"
}

here_global_dir() {
  echo "$here_base_dir/_global"
}

here_create_file() {
  local dir="$1" name="$2" content="$3"
  local filename="$dir/$name"
  [[ -f "$filename" ]] && _abort "File already exists: $filename"
  mkdir -p "$dir"
  echo "$content" > "$filename"
  $editor "$filename"
}

here_edit_file() {
  $editor "$1/$2"
}

here_show_file() {
  hicat "$1/$2"
}

_error() {
  echo >&2 "$@"
}

usage() {
  output=$(cat <<OUTPUT
Run commands specific to the current directory.

Commands are stored in a central location in your home dir, uncluttering your local directory.

Usage:

  $script [cmd] [arg1] [arg2] ... [argN]

For this directory, save scripts here:

  $(here_target_dir)
OUTPUT
  )
  _error "$output"
  exit 1
}

_abort() {
  _error "Error: $@"

  exit 1
}

show_target_dir() {
  echo "$(here_target_dir)"
}

show_global_target_dir() {
  echo "$(here_global_dir)"
}

list_scripts() {
  local local_dir global_dir has_local has_global
  local_dir="$(here_target_dir)"
  global_dir="$(here_global_dir)"

  [[ -d "$local_dir" ]] && has_local=1 || has_local=
  [[ -d "$global_dir" ]] && has_global=1 || has_global=

  if [[ -n "$has_local" && -n "$has_global" ]]; then
    echo "local:"
    ls "$local_dir" | sed 's/^/  /'
    echo ""
    echo "global:"
    ls "$global_dir" | sed 's/^/  /'
  elif [[ -n "$has_local" ]]; then
    ls "$local_dir"
  elif [[ -n "$has_global" ]]; then
    echo "global:"
    ls "$global_dir" | sed 's/^/  /'
  fi
}

create_script() {
  local content="${2-# exec ... \"\$@\" # Write your command here...}"

  local template
  template=$(cat <<OUTPUT
#!/usr/bin/env bash

$content
OUTPUT
  )

  here_create_file "$(here_target_dir)" "$1" "$template"
  chmod +x "$(here_target_dir)/$1"
}

create_global_script() {
  local content="${2-# exec ... \"\$@\" # Write your command here...}"

  local template
  template=$(cat <<OUTPUT
#!/usr/bin/env bash

$content
OUTPUT
  )

  here_create_file "$(here_global_dir)" "$1" "$template"
  chmod +x "$(here_global_dir)/$1"
}

edit_script() {
  here_edit_file "$(here_target_dir)" "$1"
}

edit_global_script() {
  here_edit_file "$(here_global_dir)" "$1"
}

show_script() {
  local dir
  dir="$(here_target_dir)"
  if [[ ! -f "$dir/$1" ]]; then
    local gdir
    gdir="$(here_global_dir)"
    [[ -f "$gdir/$1" ]] && dir="$gdir" || _abort "Script does not exist: $dir/$1"
  fi
  here_show_file "$dir" "$1"
}

run_script(){
  local dir
  dir="$(here_target_dir)"
  if [[ ! -f "$dir/$1" ]]; then
    local gdir
    gdir="$(here_global_dir)"
    [[ -f "$gdir/$1" ]] && dir="$gdir" || _abort "Script does not exist: $dir/$1"
  fi
  exec "$dir/$@"
}

[[ $# -ge 1 ]] || usage

if [[ "$1" == "--"* ]]; then
  opt="$1"
  shift
  case "$opt" in
    "--list" )
        list_scripts "$@"; exit $?;;
    "--create" )
        create_script "$@"; exit $?;;
    "--edit" )
        edit_script "$@"; exit $?;;
    "--show" )
        show_script "$@"; exit $?;;
    "--dir" )
        show_target_dir "$@"; exit $?;;
    "--global-create" )
        create_global_script "$@"; exit $?;;
    "--global-edit" )
        edit_global_script "$@"; exit $?;;
    "--global-dir" )
        show_global_target_dir "$@"; exit $?;;
    *) _abort "Invalid option: $@";;
  esac
fi

run_script "$@"
