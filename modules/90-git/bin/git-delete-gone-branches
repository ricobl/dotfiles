#!/bin/bash

# Shows local branches that are gone on the first remote available (usually `origin`)

remote=`git remote | head -1`

branches=$(
  git branch -vv \
    | grep "$remote/.*: gone]" \
    | grep -vE "(master|main)" \
    | sed -E "s/^\+//" \
    | awk '{print $1}' \
)

echo "$branches" | xargs git branch -D
